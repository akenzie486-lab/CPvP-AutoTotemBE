
name: Build LeviPack

on:
  push:
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - uses: actions/checkout@v4

      - name: Compile Native Library
        run: |
          $ANDROID_NDK_LATEST_HOME/toolchains/llvm/prebuilt/linux-x86_64/bin/aarch64-linux-android30-clang++ \
            -shared -fPIC -O3 \
            src/main.cpp \
            -o libCPvPAutoTotem.so

      - name: Prepare LeviPack
        run: |
          mkdir -p package
          cp manifest.json package/
          cp libCPvPAutoTotem.so package/

      - name: Create LeviPack
        run: |
          cd package
          zip -r ../CPvPAutoTotem.levipack .

      - name: Upload LeviPack
        uses: actions/upload-artifact@v4
        with:
          name: CPvPAutoTotem-LeviPack
          path: CPvPAutoTotem.levipack
